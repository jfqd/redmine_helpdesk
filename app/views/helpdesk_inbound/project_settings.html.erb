<div style="max-width: 860px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
    <h2 style="margin: 0;">Helpdesk &amp; Multi-Domain Settings &mdash; <%= @project.name %></h2>
    <span style="background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 999px; padding: 3px 10px; font-size: 12px; font-weight: 600;">Enterprise v1.0.0</span>
  </div>

  <div class="tabs" id="helpdesk-tabs" style="margin-bottom: 14px;">
    <ul>
      <li><a href="#hd-mailbox" class="selected" onclick="hdSwitchTab(this, 0); return false;">Mailbox &amp; Routing</a></li>
      <li><a href="#hd-sla" onclick="hdSwitchTab(this, 1); return false;">SLA &amp; Canned Responses</a></li>
    </ul>
  </div>

  <%= form_tag(project_helpdesk_settings_path(@project), method: :post, class: 'tabular') do %>
    <div id="hd-tab-0" class="box" style="border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; padding: 16px;">
      <p>
        <label for="helpdesk_enabled">Enable Helpdesk for this Project</label>
        <%= check_box_tag 'enabled', '1', @helpdesk_config['enabled'] == '1', id: 'helpdesk_enabled' %>
      </p>
      <p>
        <label for="helpdesk_sender_email">Dedicated Support Email</label>
        <%= text_field_tag 'sender_email', @helpdesk_config['sender_email'], id: 'helpdesk_sender_email', size: 45, placeholder: 'support@client-domain.com' %>
        <em class="info">Incoming emails to this address route directly to this project.</em>
      </p>
      <p>
        <label for="helpdesk_reply_to">Reply-To Email</label>
        <%= text_field_tag 'reply_to', @helpdesk_config['reply_to'], id: 'helpdesk_reply_to', size: 45, placeholder: 'support@client-domain.com' %>
      </p>
      <hr />
      <p>
        <label for="helpdesk_smtp_address">SMTP Host / Server</label>
        <%= text_field_tag 'smtp_address', @helpdesk_config['smtp_address'], id: 'helpdesk_smtp_address', size: 40, placeholder: 'smtp.client-domain.com' %>
      </p>
      <p>
        <label for="helpdesk_smtp_port">SMTP Port</label>
        <%= number_field_tag 'smtp_port', @helpdesk_config['smtp_port'] || 587, id: 'helpdesk_smtp_port', min: 1, max: 65535 %>
      </p>
      <p>
        <label for="helpdesk_smtp_username">SMTP Username</label>
        <%= text_field_tag 'smtp_username', @helpdesk_config['smtp_username'], id: 'helpdesk_smtp_username', size: 40 %>
      </p>
      <p>
        <label for="helpdesk_smtp_password">SMTP Password</label>
        <%= password_field_tag 'smtp_password', @helpdesk_config['smtp_password'], id: 'helpdesk_smtp_password', size: 40 %>
      </p>
      <p>
        <label for="helpdesk_smtp_tls">Enable STARTTLS / TLS</label>
        <%= check_box_tag 'smtp_tls', '1', @helpdesk_config['smtp_tls'] != '0', id: 'helpdesk_smtp_tls' %>
        &nbsp; <%= link_to 'Test SMTP Connection', project_helpdesk_test_smtp_path(@project), method: :post, class: 'icon icon-reload' %>
      </p>
      <hr />
      <p>
        <label for="helpdesk_imap_host">Incoming IMAP Host</label>
        <%= text_field_tag 'imap_host', @helpdesk_config['imap_host'], id: 'helpdesk_imap_host', size: 40, placeholder: 'imap.client-domain.com' %>
      </p>
      <p>
        <label for="helpdesk_imap_port">IMAP Port (SSL)</label>
        <%= number_field_tag 'imap_port', @helpdesk_config['imap_port'] || 993, id: 'helpdesk_imap_port', min: 1, max: 65535 %>
      </p>
      <p>
        <label for="helpdesk_imap_username">IMAP Username</label>
        <%= text_field_tag 'imap_username', @helpdesk_config['imap_username'], id: 'helpdesk_imap_username', size: 40 %>
      </p>
      <p>
        <label for="helpdesk_imap_password">IMAP Password</label>
        <%= password_field_tag 'imap_password', @helpdesk_config['imap_password'], id: 'helpdesk_imap_password', size: 40 %>
      </p>
    </div>

    <div id="hd-tab-1" class="box" style="display: none; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; padding: 16px;">
      <p>
        <label for="helpdesk_sla_first">First Response SLA (hours)</label>
        <%= number_field_tag 'sla_first_response_hours', @helpdesk_config['sla_first_response_hours'] || 4, id: 'helpdesk_sla_first', min: 1 %>
      </p>
      <p>
        <label for="helpdesk_sla_res">Resolution SLA (hours)</label>
        <%= number_field_tag 'sla_resolution_hours', @helpdesk_config['sla_resolution_hours'] || 24, id: 'helpdesk_sla_res', min: 1 %>
      </p>
      <p>
        <label for="helpdesk_canned">Canned Responses (Title | Body)</label>
        <%= text_area_tag 'canned_responses', @helpdesk_config['canned_responses'], id: 'helpdesk_canned', rows: 5, cols: 60, placeholder: "Greeting | Thank you for contacting support.\nResolved | Your issue has been resolved." %>
      </p>
      <p>
        <label for="helpdesk_auto_reply">Send Auto-Reply Confirmation</label>
        <%= check_box_tag 'auto_reply_enabled', '1', @helpdesk_config['auto_reply_enabled'] == '1', id: 'helpdesk_auto_reply' %>
      </p>
      <p>
        <label for="helpdesk_auto_prio">Auto-Priority Keywords (comma-separated)</label>
        <%= text_field_tag 'auto_priority_keywords', @helpdesk_config['auto_priority_keywords'] || 'urgent, down, outage', id: 'helpdesk_auto_prio', size: 50 %>
      </p>
      <p>
        <label for="helpdesk_blacklist">Spam / Blacklist Domains (comma-separated)</label>
        <%= text_field_tag 'blacklist_domains', @helpdesk_config['blacklist_domains'], id: 'helpdesk_blacklist', size: 50, placeholder: 'spam.com, blocked.org' %>
      </p>
      <p>
        <label for="helpdesk_att_blacklist">Blocked Attachment Extensions</label>
        <%= text_field_tag 'attachment_blacklist', @helpdesk_config['attachment_blacklist'] || '.exe, .bat, .sh, .js', id: 'helpdesk_att_blacklist', size: 50 %>
      </p>
      <p>
        <label>Embeddable Support Widget</label>
        <code>&lt;script src="<%= helpdesk_widget_url(@project, format: :js) %>"&gt;&lt;/script&gt;</code>
      </p>
    </div>

    <%= submit_tag l(:button_save), class: 'button-positive' %>
  <% end %>
</div>
<script>
function hdSwitchTab(el, idx) {
  document.querySelectorAll('#helpdesk-tabs a').forEach(function(a) { a.classList.remove('selected'); });
  el.classList.add('selected');
  document.getElementById('hd-tab-0').style.display = idx === 0 ? '' : 'none';
  document.getElementById('hd-tab-1').style.display = idx === 1 ? '' : 'none';
}
</script>
